# SpecGuard Environment Configuration
# Copy this to .env and fill in your values

# OpenAI API Key (required for live generation only; never needed by tests)
OPENAI_API_KEY=sk-your-key-here

# Database URL
# For development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./specguard.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/specguard

# AI Model Configuration
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_RETRIES=2

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Durable local evaluator (apply migrations before starting the worker)
EVALUATION_DB=.specguard-data/evaluations.db
EVALUATION_ARTIFACTS=../benchmark-runs/web
# Set to the sha256 ID returned by docker image inspect after building the runner
EVALUATION_RUNNER_IMAGE=
EVALUATION_RETENTION_DAYS=7
EVALUATION_STORAGE_MB=1024
EVALUATION_RUN_STORAGE_MB=128
